diff --git a/tools/server/dyno-capture.h b/tools/server/dyno-capture.h
new file mode 100644
index 0000000..fdc2783
--- /dev/null
+++ b/tools/server/dyno-capture.h
@@ -0,0 +1,71 @@
+#pragma once
+#include "ggml-backend.h"
+#include <cmath>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+#include <algorithm>
+
+struct dyno_capture_state {
+    bool enabled = false;
+    bool vectors_enabled = false;
+    std::map<int, std::vector<std::vector<float>>> vectors;
+    int patch_layer = -1;
+    int patch_position = -1;
+    std::vector<float> patch_vector;
+    int task_id = -1;
+    int token_count = 0;
+    std::vector<int> layers;
+    std::map<int, std::vector<double>> norms;
+    std::map<int, std::string> backends;
+    std::string error;
+};
+
+static bool dyno_capture_callback(ggml_tensor * t, bool ask, void * user_data) {
+    auto & state = *static_cast<dyno_capture_state *>(user_data);
+    if (!state.enabled) return !ask;
+    int layer = -1;
+    char rest = 0;
+    if (sscanf(t->name, "l_out-%d%c", &layer, &rest) != 1 ||
+        std::find(state.layers.begin(), state.layers.end(), layer) == state.layers.end()) return !ask;
+    if (ask) return true;
+    try {
+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || t->ne[1] != state.token_count ||
+            t->ne[2] != 1 || t->ne[3] != 1 || ggml_nbytes(t) > 64*1024*1024) {
+            state.error = "Unsupported activation layout or capture size";
+            return true;
+        }
+        std::vector<float> data(ggml_nelements(t));
+        ggml_backend_tensor_get(t, data.data(), 0, ggml_nbytes(t));
+        if (state.patch_layer == layer) {
+            if (state.patch_position < 0 || state.patch_position >= t->ne[1] ||
+                state.patch_vector.size() != size_t(t->ne[0])) {
+                state.error = "Patch position or hidden dimension mismatch"; return true;
+            }
+            std::copy(state.patch_vector.begin(), state.patch_vector.end(),
+                      data.begin() + state.patch_position*t->ne[0]);
+            ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+        }
+        if (state.vectors_enabled) {
+            if (ggml_nbytes(t) > 4*1024*1024) { state.error = "Vector capture exceeds 4 MiB per layer"; return true; }
+            auto & rows = state.vectors[layer]; rows.clear();
+            for (int64_t token=0; token<t->ne[1]; ++token) {
+                rows.emplace_back(data.begin()+token*t->ne[0], data.begin()+(token+1)*t->ne[0]);
+            }
+        }
+        auto & norms = state.norms[layer];
+        norms.clear();
+        for (int64_t token = 0; token < t->ne[1]; ++token) {
+            double sum = 0;
+            for (int64_t channel = 0; channel < t->ne[0]; ++channel) {
+                double value = data[token*t->ne[0]+channel];
+                sum += value*value;
+            }
+            if (!std::isfinite(sum)) { state.error = "Non-finite activation"; return true; }
+            norms.push_back(std::sqrt(sum));
+        }
+        state.backends[layer] = ggml_backend_buffer_name(t->buffer);
+    } catch (const std::exception & e) { state.error = e.what(); }
+    return true;
+}
